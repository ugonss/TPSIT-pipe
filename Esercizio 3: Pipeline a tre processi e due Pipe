#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <time.h>
#include <sys/wait.h>

int main(void) {
    srand(time(NULL));
    int fd1[2], fd2[2];

    if (pipe(fd1) == -1) {
        perror("Errore nella pipe 1");
        exit(1);
    }
    if (pipe(fd2) == -1) {
        perror("Errore nella pipe 2");
        exit(1);
    }

    pid_t pid1 = fork();
    if (pid1 == -1) {
        perror("Errore nel fork 1");
        exit(1);
    }

    if (pid1 == 0) {
        close(fd1[1]);
        close(fd2[0]);

        int n;
        while (read(fd1[0], &n, sizeof(n)) > 0) {
            if (n >= 50) {
                int quadrato = n * n;
                write(fd2[1], &quadrato, sizeof(quadrato));
            }
        }

        close(fd1[0]);
        close(fd2[1]);
        exit(0);
    }

    pid_t pid2 = fork();
    if (pid2 == -1) {
        perror("Errore nel fork 2");
        exit(1);
    }

    if (pid2 == 0) {
        close(fd1[0]);
        close(fd1[1]);
        close(fd2[1]);

        int q, conta = 0;
        double somma = 0;

        while (read(fd2[0], &q, sizeof(q)) > 0) {
            printf("%d\n", q);
            somma += q;
            conta++;
        }
        close(fd2[0]);

        if (conta > 0)
            printf("Media: %.2f\n", somma / conta);
        else
            printf("Nessun numero ricevuto\n");

        exit(0);
    }

    close(fd1[0]);
    close(fd2[0]);
    close(fd2[1]);

    for (int i = 0; i < 20; i++) {
        int n = rand() % 100 + 1;
        write(fd1[1], &n, sizeof(n));
    }
    close(fd1[1]);

    wait(NULL);
    wait(NULL);

    return 0;
}
